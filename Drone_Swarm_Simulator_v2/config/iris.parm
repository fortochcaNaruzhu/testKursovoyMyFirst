FRAME_CLASS      1          # Multirotor
FRAME_TYPE       1          # X class

ATC_ANG_PIT_P    0.5
ATC_ANG_RLL_P    0.5
ATC_ANG_YAW_P    0.5

ATC_RAT_PIT_P    0.05
ATC_RAT_RLL_P    0.05
ATC_RAT_YAW_P    0.02 

ATC_RAT_PIT_I    0
ATC_RAT_RLL_I    0

ATC_RAT_PIT_D    0.0003
ATC_RAT_RLL_D    0.0003  
ATC_RAT_YAW_D    0.000001

AHRS_EKF_TYPE    10         # Use sim AHRS
ARMING_CHECK	 0    # No RC requirements
MOT_THST_EXPO    0          # No motor exponential
SCHED_LOOP_RATE  300        
INS_GYR_CAL      0

# === Общий параметр для всех режимов с удержанием позиции ===
# Максимальный угол наклона (крен и тангаж) в сантиградусах
# Контролирует максимальный угол наклона в POS_HOLD и Loiter режимах
# По умолчанию: 4500 (45 градусов)
# 1 градус = 100 сантиградусов, поэтому 5500 = 55 градусов
# ANGLE_MAX        5500

# === MAVLink streamrate fix (prevent fall-back to ~4 Hz) ===
# Set POSITION stream rate (GLOBAL_POSITION_INT + LOCAL_POSITION_NED) for several channels.
# In SITL/UDP setups, the exact SRx channel mapping can vary; setting SR0..SR3 covers typical cases.
SR0_POSITION     50
SR1_POSITION     50
SR2_POSITION     50
SR3_POSITION     50

# Ignore legacy REQUEST_DATA_STREAM overrides (bit 12 = 4096) so a late client can't reset rates.
SERIAL0_OPTIONS  4096
SERIAL1_OPTIONS  4096
SERIAL2_OPTIONS  4096
SERIAL3_OPTIONS  4096
