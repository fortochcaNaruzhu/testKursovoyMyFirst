FRAME_CLASS      1          # Multirotor
FRAME_TYPE       1          # X class

ATC_ANG_PIT_P    0.5
ATC_ANG_RLL_P    0.5
ATC_ANG_YAW_P    0.5

ATC_RAT_PIT_P    0.05
ATC_RAT_RLL_P    0.05
ATC_RAT_YAW_P    0.02 

ATC_RAT_PIT_I    0
ATC_RAT_RLL_I    0

ATC_RAT_PIT_D    0.0003
ATC_RAT_RLL_D    0.0003  
ATC_RAT_YAW_D    0.000001

AHRS_EKF_TYPE    3         # Use sim AHRS
EK3_ENABLE       1
ARMING_CHECK	 0    # No RC requirements
MOT_THST_EXPO    0          # No motor exponential
SCHED_LOOP_RATE  300        
INS_GYR_CAL      0

# === Общий параметр для всех режимов с удержанием позиции ===
# Максимальный угол наклона (крен и тангаж) в сантиградусах
# Контролирует максимальный угол наклона в POS_HOLD и Loiter режимах
# По умолчанию: 4500 (45 градусов)
# 1 градус = 100 сантиградусов, поэтому 5500 = 55 градусов
# ANGLE_MAX        5500

# === MAVLink streamrate fix (prevent fall-back to ~4 Hz) ===
# Stream rates (GLOBAL_POSITION_INT / др.): симулятор также запрашивает SIM_STATE по MAVLink из Python.
# In SITL/UDP setups, the exact SRx channel mapping can vary; setting SR0..SR3 covers typical cases.
SR0_POSITION     50
SR1_POSITION     50
SR2_POSITION     50
SR3_POSITION     50

# Bit 12 (4096) = OPTION_NOSTREAMOVERRIDE: ignore legacy MAVLink REQUEST_DATA_STREAM only.
# It does NOT block MAV_CMD_SET_MESSAGE_INTERVAL (used by pymavlink / scripts). Remove duplicate
# interval requests in scenarios and loggers so SR*_POSITION above is the single source of truth.
SERIAL0_OPTIONS  4096
SERIAL1_OPTIONS  4096
SERIAL2_OPTIONS  4096
SERIAL3_OPTIONS  4096

# === SITL wind model ===
# Direction wind is coming from, true degrees (180 = from South).
SIM_WIND_DIR    90
# Base wind speed, m/s.
SIM_WIND_SPD    0
# Random wind variation/turbulence, m/s (0 = steady wind).
SIM_WIND_TURB   0
# Wind change time constant, seconds.
SIM_WIND_TC     5




# === SITL sensor noise ===
# GPS altitude noise amplitude, m.
SIM_GPS1_NOISE   0 #1.5
SIM_GPS1_DRFTALT 0 #0.5
SIM_GPS1_VERR_X  0 #0.2
SIM_GPS1_VERR_Y  0 #0.2
SIM_GPS1_VERR_Z  0 #0.2
# Barometer altitude noise, m.
SIM_BARO_RND     0 #0.3
# Barometer altitude drift, m/s.
SIM_BARO_DRIFT   0 #0.01